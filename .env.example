# ---------------------------------------------------------------------------
# Adres kanoniczny witryny (bez ukośnika na końcu).
#
# Ustaw dopiero wtedy, gdy domena wskazuje na wdrożenie. Wcześniej zostaw pusty:
# na Vercelu projekt sam użyje adresu *.vercel.app, dzięki czemu canonical,
# Open Graph i sitemapa nie wskażą domeny prowadzącej gdzie indziej.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=""

# ---------------------------------------------------------------------------
# Źródło treści: wordpress | sanity | seed
#
# Puste albo `auto` = wykrywanie automatyczne: najpierw WordPress, potem
# Sanity, a gdy nie ma żadnego — treść startowa z src/content.
# ---------------------------------------------------------------------------
CONTENT_SOURCE=""

# ---------------------------------------------------------------------------
# WordPress headless
# Adres REST API, bez ukośnika na końcu. To nie jest sekret.
# Instrukcja instalacji: wordpress/README.md
# ---------------------------------------------------------------------------
WORDPRESS_API_URL=""

# ---------------------------------------------------------------------------
# Sanity (headless CMS)
# Bez tych zmiennych strona działa na wbudowanej treści startowej (seed),
# a Studio pod /studio jest wyłączone.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"
# Token tylko do odczytu (opcjonalny, wymagany dla prywatnego datasetu)
SANITY_API_READ_TOKEN=""
# ---------------------------------------------------------------------------
# Sekret webhooka odświeżającego treść: /api/revalidate
# Działa dla obu CMS-ów. To JEST sekret — trzymaj go w panelu Vercela,
# nie w repozytorium. Stara nazwa SANITY_REVALIDATE_SECRET nadal działa.
# ---------------------------------------------------------------------------
CONTENT_REVALIDATE_SECRET=""

# ---------------------------------------------------------------------------
# Formularz kontaktowy (Resend)
# Bez klucza formularz waliduje dane i loguje zgłoszenie zamiast je wysyłać.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
CONTACT_EMAIL_TO="tomasz.majewski1994@gmail.com"
CONTACT_EMAIL_FROM="Formularz <formularz@majewskitomasz.pl>"

# ---------------------------------------------------------------------------
# Weryfikacja Google Search Console (opcjonalna)
# ---------------------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=""
