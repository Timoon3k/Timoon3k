# ===========================================================================
# MSdream — zmienne środowiskowe
#
# Skopiuj ten plik do `.env.local` i uzupełnij. Nigdy nie commituj `.env.local`.
#
# Strona URUCHAMIA SIĘ I BUDUJE BEZ ŻADNEJ Z TYCH ZMIENNYCH — korzysta wtedy
# z treści startowej, a integracje pokazują jawny stan „do skonfigurowania”
# zamiast udawać, że działają.
# ===========================================================================

# ---------------------------------------------------------------------------
# Adres kanoniczny (bez ukośnika na końcu)
#
# Ustaw dopiero, gdy domena wskazuje na wdrożenie. Wcześniej zostaw pusty:
# na Vercelu projekt sam użyje adresu *.vercel.app, dzięki czemu canonical,
# Open Graph i sitemapa nie wskażą domeny prowadzącej gdzie indziej.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=""

# ---------------------------------------------------------------------------
# CMS — headless WordPress
#
# Adres REST API, czyli adres WordPressa + `/wp-json`.
# Bez tej zmiennej strona działa na treści startowej z `src/content`.
# ---------------------------------------------------------------------------
WORDPRESS_API_URL=""
# Dodatkowe hosty multimediów (CDN, osobna subdomena uploadów),
# rozdzielone przecinkami. Zwykle zostaw puste.
WORDPRESS_MEDIA_HOSTS=""
# Sekret webhooka odświeżającego cache (`/api/revalidate`).
# Tę samą wartość wpisz w `wp-config.php` jako MSDREAM_REVALIDATE_SECRET.
CMS_REVALIDATE_SECRET=""

# ---------------------------------------------------------------------------
# Bookero — system rezerwacji
#
# ID wtyczki znajdziesz w panelu Bookero → zakładka „Integracje”.
# Bez niego strony /rezerwacja i /rezerwacja-tuftingu pokazują komunikat
# o brakującej konfiguracji zamiast kalendarza.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BOOKERO_PLUGIN_ID=""
# Opcjonalnie: osobna wtyczka dla warsztatów tuftingu.
# Puste = tufting korzysta z wtyczki głównej.
NEXT_PUBLIC_BOOKERO_PLUGIN_ID_TUFTING=""

# ---------------------------------------------------------------------------
# HotPay — płatności
#
# Wypełnij TYLKO wtedy, gdy płatności obsługuje ta aplikacja.
# Jeśli płatności są realizowane w całości po stronie Bookero
# (zalecane — patrz INTEGRATIONS.md), zostaw puste.
#
# HOTPAY_SECRET   → „SEKRET” usługi z panelu HotPay
# HOTPAY_PASSWORD → „hasło z ustawień” usługi (pierwszy człon skrótu HASH)
# ---------------------------------------------------------------------------
HOTPAY_SECRET=""
HOTPAY_PASSWORD=""

# ---------------------------------------------------------------------------
# Fakturownia — dokumenty sprzedaży
#
# FAKTUROWNIA_ACCOUNT to poddomena konta: dla msdream.fakturownia.pl → "msdream"
# Token: Ustawienia → Ustawienia konta → Integracja → Kod autoryzacyjny API
# ---------------------------------------------------------------------------
FAKTUROWNIA_API_TOKEN=""
FAKTUROWNIA_ACCOUNT=""
# Rodzaj domyślnego dokumentu: "receipt" (paragon) albo "vat" (faktura VAT)
FAKTUROWNIA_DEFAULT_KIND="receipt"
# Stawka VAT dla usług rekreacyjnych — potwierdź z księgowością.
FAKTUROWNIA_VAT_RATE="23"

# ---------------------------------------------------------------------------
# Formularz kontaktowy (Resend)
#
# Bez klucza formularz NIE udaje wysyłki: zwraca czytelny błąd konfiguracji
# i zapisuje zgłoszenie w logu serwera.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
CONTACT_EMAIL_TO=""
CONTACT_EMAIL_FROM=""

# ---------------------------------------------------------------------------
# Mapa Google (opcjonalna)
#
# Bez klucza sekcja mapy pokazuje stylizowaną fasadę z przyciskiem
# „Otwórz w Google Maps”. Z kluczem — osadzoną mapę, ładowaną dopiero
# po kliknięciu użytkownika.
# Włącz „Maps Embed API” w Google Cloud i ogranicz klucz do swojej domeny.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=""

# ---------------------------------------------------------------------------
# Analityka (opcjonalna)
#
# Skrypty ładują się WYŁĄCZNIE po zgodzie użytkownika na cookies.
# Puste wartości = baner cookies w ogóle się nie pokazuje (nie ma o co pytać).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
GOOGLE_SITE_VERIFICATION=""
