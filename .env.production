# ---------------------------------------------------------------------------
# Zmienne publiczne wczytywane przy budowaniu wersji produkcyjnej.
#
# Ten plik jest CELOWO w repozytorium. Next.js wczytuje go automatycznie
# podczas `next build`, więc Vercel zbuduje projekt z tymi wartościami bez
# ustawiania czegokolwiek w panelu.
#
# WOLNO tu wpisywać wyłącznie zmienne z przedrostkiem NEXT_PUBLIC_.
# Trafiają one do kodu wysyłanego do przeglądarki, więc z definicji nie są
# tajne — identyfikator projektu Sanity i tak jest widoczny w źródle strony.
#
# NIGDY nie wpisuj tutaj:
#   RESEND_API_KEY, SANITY_API_READ_TOKEN, SANITY_REVALIDATE_SECRET
# To sekrety. Umieszczone w repozytorium stałyby się publiczne i trzeba by je
# unieważnić. Ich miejsce jest w zmiennych środowiskowych projektu na Vercelu.
# ---------------------------------------------------------------------------

# Wklej Project ID z sanity.io/manage, żeby włączyć panel treści pod /studio.
# Puste = witryna działa na treści wbudowanej w kod, a /studio zwraca 404.
NEXT_PUBLIC_SANITY_PROJECT_ID=6zxmfjuw
NEXT_PUBLIC_SANITY_DATASET=production

# Ustaw dopiero po podpięciu domeny — wcześniej projekt sam użyje adresu,
# pod którym faktycznie stoi.
NEXT_PUBLIC_SITE_URL=
