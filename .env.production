# ---------------------------------------------------------------------------
# Zmienne wczytywane przy budowaniu wersji produkcyjnej.
#
# Ten plik jest CELOWO w repozytorium. Next.js wczytuje go automatycznie
# podczas `next build`, więc Vercel zbuduje projekt z tymi wartościami bez
# ustawiania czegokolwiek w panelu.
#
# WOLNO tu wpisywać wyłącznie wartości, które NIE SĄ TAJNE. Plik jest w
# repozytorium, więc wszystko, co tu trafi, jest publiczne.
#
# NIGDY nie wpisuj tutaj:
#   RESEND_API_KEY, SANITY_API_READ_TOKEN, CONTENT_REVALIDATE_SECRET
# To sekrety. Umieszczone w repozytorium trzeba by unieważnić. Ich miejsce
# jest w zmiennych środowiskowych projektu na Vercelu (są na darmowym planie).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Źródło treści: wordpress | sanity | seed
# Puste = wykrywanie automatyczne (najpierw WordPress, potem Sanity,
# a gdy nie ma żadnego — treść startowa wbudowana w kod).
# ---------------------------------------------------------------------------
CONTENT_SOURCE=

# ---------------------------------------------------------------------------
# WordPress headless — adres REST API, bez ukośnika na końcu.
# Przykład: https://cms.majewskitomasz.pl/wp-json
# Instrukcja instalacji: wordpress/README.md
#
# Uzupełnij oba pola poniżej, żeby przełączyć stronę na WordPressa:
#   CONTENT_SOURCE=wordpress
#   WORDPRESS_API_URL=https://…/wp-json
# ---------------------------------------------------------------------------
WORDPRESS_API_URL=

# ---------------------------------------------------------------------------
# Sanity — Project ID z sanity.io/manage. Włącza panel treści pod /studio.
# Puste = /studio zwraca 404.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=6zxmfjuw
NEXT_PUBLIC_SANITY_DATASET=production

# Ustaw dopiero po podpięciu domeny — wcześniej projekt sam użyje adresu,
# pod którym faktycznie stoi.
NEXT_PUBLIC_SITE_URL=
